{
  "schemaVersion": 1,
  "id": "foamy.teams",
  "name": "Foamy Teams",
  "version": "1.1.0",
  "author": "foamrider",
  "description": "Configurable Teams account launcher and window-title unread status",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Microsoft Teams",
    "description": "Teams accounts and unread status",
    "category": "Communication",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "accounts": [],
      "showCount": true,
      "hideWhenClosed": false,
      "showContext": false,
      "showClosed": true,
      "unreadFirst": false,
      "defaultAccount": ""
    },
    "schema": [
      {
        "key": "showCount",
        "type": "boolean",
        "label": "Show unread count in the bar",
        "defaultValue": true
      },
      {
        "key": "hideWhenClosed",
        "type": "boolean",
        "label": "Hide when all accounts are closed",
        "defaultValue": false
      },
      {
        "key": "showContext",
        "type": "boolean",
        "label": "Show window context",
        "defaultValue": false
      },
      {
        "key": "showClosed",
        "type": "boolean",
        "label": "Show closed accounts",
        "defaultValue": true
      },
      {
        "key": "unreadFirst",
        "type": "boolean",
        "label": "Put unread accounts first",
        "defaultValue": false
      }
    ]
  },
  "license": "MIT"
}
